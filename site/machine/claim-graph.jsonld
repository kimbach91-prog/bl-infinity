  "@graph": [
    {
      "@id": "bl:BL-D-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-D-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-D-001/",
      "schema:name": "Tổng Thực Tại",
      "schema:text": "Ω ký hiệu miền bao gồm mọi thứ có tư cách tồn tại trong ontology đang xét; định nghĩa này không đồng nhất Ω với vũ trụ quan sát được.",
      "schema:additionalType": "definition",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-A-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-A-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-A-001/",
      "schema:name": "Tiên đề Nội tại",
      "schema:text": "Nếu A là một chủ thể thực sự trong Ω thì mọi trạng thái thực sự của A thuộc Ω.",
      "schema:additionalType": "axiom",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": [
        "bl:BL-D-001"
      ]
    },
    {
      "@id": "bl:BL-P-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-001/",
      "schema:name": "Hiện thực của biểu diễn",
      "schema:text": "Nếu A thực sự sinh representation r thì sự kiện sinh và trạng thái mang r là một sự kiện của Ω.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-A-001"
      ]
    },
    {
      "@id": "bl:BL-P-002",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-002",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-002/",
      "schema:name": "Representation không đồng nhất referent",
      "schema:text": "Sự tồn tại của representation về x không tự suy ra referent x được actualize độc lập.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": [
        "bl:BL-P-001"
      ]
    },
    {
      "@id": "bl:BL-A-002",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-A-002",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-A-002/",
      "schema:name": "Không-đồng-nhất Biên",
      "schema:text": "Không mặc định biên nhận thức của embedded observer bằng biên Tổng Thực Tại nếu chưa có proof closure/exhaustiveness.",
      "schema:additionalType": "axiom",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": [
        "bl:BL-D-001"
      ]
    },
    {
      "@id": "bl:BL-T-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-T-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-T-001/",
      "schema:name": "Underdetermination dưới observation map không injective",
      "schema:text": "Nếu tồn tại M1≠M2 nhưng O_A(M1)=O_A(M2), dữ liệu O_A đơn thuần không đủ xác định duy nhất global model giữa M1 và M2.",
      "schema:additionalType": "theorem",
      "schema:creativeWorkStatus": "formalizable",
      "dependsOn": [
        "bl:BL-A-002"
      ]
    },
    {
      "@id": "bl:BL-AN-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-AN-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-AN-001/",
      "schema:name": "Bổ đề Con vi khuẩn",
      "schema:text": "Vi khuẩn có thể có mô hình cục bộ cực chính xác mà vẫn không phân biệt được toàn-ruột và ruột-nằm-trong-hệ-lớn nếu observation của nó giống nhau.",
      "schema:additionalType": "analogy",
      "schema:creativeWorkStatus": "illustrative",
      "dependsOn": [
        "bl:BL-T-001"
      ]
    },
    {
      "@id": "bl:BL-A-003",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-A-003",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-A-003/",
      "schema:name": "Bản thể Mở",
      "schema:text": "Primitive/category hiện biết không được mặc định là primitive/category cuối cùng của Ω khi chưa có closure proof.",
      "schema:additionalType": "axiom",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": [
        "bl:BL-D-001"
      ]
    },
    {
      "@id": "bl:BL-T-002",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-T-002",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-T-002/",
      "schema:name": "Description-space condition",
      "schema:text": "Nếu description space của agent là countable và state space candidate có cardinality lớn hơn countable thì không thể có unique finite description cho từng state bằng description system đó.",
      "schema:additionalType": "theorem",
      "schema:creativeWorkStatus": "formalizable",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-P-003",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-003",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-003/",
      "schema:name": "Inconceivable không suy ra impossible",
      "schema:text": "Việc A không thể hình dung x không tự suy ra x bất khả trong Ω.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-A-002",
        "bl:BL-A-003"
      ]
    },
    {
      "@id": "bl:BL-D-002",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-D-002",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-D-002/",
      "schema:name": "Reachability",
      "schema:text": "h reachable từ x0 dưới repertoire U nếu tồn tại finite/allowed transformation path từ x0 tới h sử dụng operations thuộc U theo model đã chọn.",
      "schema:additionalType": "definition",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-P-004",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-004",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-004/",
      "schema:name": "Not actual không suy ra unreachable",
      "schema:text": "Một target chưa actual tại t0 vẫn có thể reachable từ trạng thái hiện tại hoặc reachable sau mở rộng capability.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-D-002"
      ]
    },
    {
      "@id": "bl:BL-P-005",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-005",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-005/",
      "schema:name": "Khả đạt động",
      "schema:text": "Khi repertoire U thay đổi, reachable set của agent có thể thay đổi; nếu capability cũ được bảo toàn và thêm operation mới thì reachable set không giảm theo inclusion trong model đó.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "formalizable",
      "dependsOn": [
        "bl:BL-D-002"
      ]
    },
    {
      "@id": "bl:BL-P-006",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-006",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-006/",
      "schema:name": "Recursive Capability Expansion",
      "schema:text": "Tool có thể giúp chế tạo tool tiếp theo, tạo chuỗi U0→U1→... và mở rộng effective reachable space qua nhiều bước.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-P-005"
      ]
    },
    {
      "@id": "bl:BL-C-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-C-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-C-001/",
      "schema:name": "Reachable–Conceivable Gap",
      "schema:text": "Có thể tồn tại trạng thái thuộc reachable space của reality nhưng nằm ngoài current conceivable space của một observer hữu hạn.",
      "schema:additionalType": "conjecture",
      "schema:creativeWorkStatus": "open",
      "dependsOn": [
        "bl:BL-P-003",
        "bl:BL-P-006"
      ]
    },
    {
      "@id": "bl:BL-P-007",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-007",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-007/",
      "schema:name": "Vô hạn thời gian không đủ",
      "schema:text": "Infinite time tự thân không entail mọi target xuất hiện nếu target không accessible hoặc dynamics không cho phép.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-D-002"
      ]
    },
    {
      "@id": "bl:BL-T-003",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-T-003",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-T-003/",
      "schema:name": "Positive-support repeated trials",
      "schema:text": "Trong mô hình independent repeated trials với p_h>0 cố định, xác suất chưa từng gặp h sau n trials là (1-p_h)^n và tiến về 0 khi n→∞.",
      "schema:additionalType": "theorem",
      "schema:creativeWorkStatus": "formal",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-A-004",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-A-004",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-A-004/",
      "schema:name": "Observation Filter",
      "schema:text": "Dữ liệu observer nhận là output của causal/access/detection/cognition filters chứ không được mặc định là sample identity của Ω.",
      "schema:additionalType": "axiom",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": [
        "bl:BL-D-001"
      ]
    },
    {
      "@id": "bl:BL-P-008",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-008",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-008/",
      "schema:name": "Observed distribution có thể lệch ontological distribution",
      "schema:text": "Nếu observation filters không identity và có selection effects, distribution dữ liệu quan sát có thể khác distribution của domain nguồn.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-A-004"
      ]
    },
    {
      "@id": "bl:BL-P-009",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-009",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-009/",
      "schema:name": "Primitive expansion có thể mở combinatorial space",
      "schema:text": "Thêm primitive/operator mới vào một closure system có thể tạo nhiều cấu hình mới hơn việc chỉ thêm một entity đơn lẻ.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-A-005",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-A-005",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-A-005/",
      "schema:name": "Plenitude BL∞",
      "schema:text": "Extension mạnh: mọi h nhất quán theo logic L được hiện thực hóa ở ít nhất một miền W⊆Ω.",
      "schema:additionalType": "axiom",
      "schema:creativeWorkStatus": "optional-speculative",
      "dependsOn": [
