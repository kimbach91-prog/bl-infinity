      "schema:identifier": "BL-M-002",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-M-002/",
      "schema:name": "Recursive Optimizer epistemology",
      "schema:text": "Đánh giá hệ nhận thức qua error detection, revision quality và useful retention; critique chất lượng trở thành input cho phiên bản tiếp theo.",
      "schema:additionalType": "method",
      "schema:creativeWorkStatus": "method-proposed",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-PROT-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-001/",
      "schema:name": "Level-Matched Critique",
      "schema:text": "Critique muốn có sức refutation phải chỉ ra claim/premise/inference/evidence hoặc biến quyết định truth-status mà nó tấn công.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "canonical-protocol",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-PROT-002",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-002",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-002/",
      "schema:name": "Preservation before validation",
      "schema:text": "Hypothesis có thể được archive/timestamp ở trạng thái unverified mà không được endorsement.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "canonical-protocol",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-P-013",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-013",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-013/",
      "schema:name": "Component prior art không entail framework identity",
      "schema:text": "Việc các component của framework có prior art không tự suy ra toàn architecture tương đương prior framework.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-P-014",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-014",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-014/",
      "schema:name": "Historical priority không đồng nhất independent derivation",
      "schema:text": "Một người có thể independently derive một result sau khi người khác đã publish nó; priority và derivation independence là hai biến khác nhau.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-PROT-003",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-003",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-003/",
      "schema:name": "Tool neutrality",
      "schema:text": "Việc dùng AI, calculator, code hoặc compute không tự quyết định truth-value; tool critique chỉ có sức nặng khi nối được tới lỗi cụ thể hoặc provenance issue.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "canonical-protocol",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-PROT-004",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-004",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-004/",
      "schema:name": "Universal publication, earned epistemic weight",
      "schema:text": "Quyền đưa research object công khai có thể phổ quát, trong khi trọng lượng epistemic được quyết định bởi chất lượng claim/evidence/verification chứ không mặc định ngang nhau.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "normative-proposal",
      "dependsOn": [
        "bl:BL-PROT-002"
      ]
    },
    {
      "@id": "bl:BL-PROT-005",
