        "bl:BL-ENO",
        "bl:BL-IDR"
      ]
    },
    {
      "@id": "bl:BL-IFH",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-IFH",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-IFH/",
      "schema:name": "Innovation Fractal Hierarchy",
      "schema:text": "Phát kiến có thể được mô hình thành hierarchy primitive→mechanism→module→subsystem→architecture→metasystem, trong đó một object vừa là whole ở cấp dưới vừa là component ở cấp trên.",
      "schema:additionalType": "model",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-NCI"
      ]
    },
    {
      "@id": "bl:BL-FCR",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-FCR",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-FCR/",
      "schema:name": "Functional Constituent Reclassification",
      "schema:text": "Một component cũ có role mới trong system mới có thể được định nghĩa như functional object mới c′=(c,Role_new) mà không claim ownership primitive c.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-NCI",
        "bl:BL-FNO"
      ]
    },
    {
      "@id": "bl:BL-TNI",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-TNI",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-TNI/",
      "schema:name": "Topological Novelty of Integration",
      "schema:text": "Nếu integration topology tạo feedback loops/capabilities mới, integration itself là candidate invention dù module set overlap prior art.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-ANO",
        "bl:BL-FNO"
      ]
    },
    {
      "@id": "bl:BL-SRS",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-SRS",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-SRS/",
      "schema:name": "Social Response to Proposition System",
      "schema:text": "Phản ứng xã hội với mệnh đề được đo theo attention, understanding, objection quality, restatement và derivative ideas thay vì đồng nhất popularity với truth.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-PROT-004"
      ]
    },
    {
      "@id": "bl:BL-ICO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-ICO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-ICO/",
      "schema:name": "Indexable Claim Object",
      "schema:text": "Mỗi claim có stable ID, canonical URL riêng, metadata, dependencies, attack surface, machine representation, sitemap entry và discussion surface riêng.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "implemented",
      "dependsOn": [
        "bl:BL-PROT-005",
        "bl:BL-PROT-008"
      ]
    },
    {
      "@id": "bl:BL-PIRAL",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PIRAL",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PIRAL/",
      "schema:name": "Publish–Index–Reaction–Audit Loop",
      "schema:text": "Sau packaging, research object đi qua publish→index→reaction→classify→deep audit→patch→version→republish, với khả năng hạ/sửa/loại claim.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "implemented",
      "dependsOn": [
        "bl:BL-PROT-006",
        "bl:BL-SRS",
        "bl:BL-ICO"
      ]
    },
