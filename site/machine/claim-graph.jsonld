      "schema:identifier": "BL-CAF",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-CAF/",
      "schema:name": "Continuous Associative Feeding",
      "schema:text": "Nạp tri thức liên tục không chỉ thêm node mà có thể tạo thêm candidate relations với corpus nội bộ đã có.",
      "schema:additionalType": "mechanism",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-P-010",
        "bl:BL-P-012"
      ]
    },
    {
      "@id": "bl:BL-CRE",
