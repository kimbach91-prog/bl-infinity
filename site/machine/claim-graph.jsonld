      "schema:identifier": "BL-PROT-005",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-005/",
      "schema:name": "Proof-Carrying Research Object",
      "schema:text": "Research object nên mang claim IDs, premises, derivations, evidence, provenance, critiques, history và signatures để tăng auditability.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "technology-proposal",
      "dependsOn": [
        "bl:BL-PROT-001",
        "bl:BL-PROT-002"
      ]
    },
    {
      "@id": "bl:BL-PROT-006",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-006",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-006/",
      "schema:name": "Deep Audit Loop",
      "schema:text": "Đóng gói claim trước, sau đó audit semantic/formal/empirical/prior-art/self-sealing theo vòng issue→patch→reaudit.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "technology-proposal",
      "dependsOn": [
        "bl:BL-PROT-005"
      ]
    },
    {
      "@id": "bl:BL-PROT-007",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-007",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-007/",
      "schema:name": "Machine-first adversarial review is not machine truth vote",
      "schema:text": "Nhiều AI được dùng như heterogeneous attack processors; mức đồng ý của model không tự là proof.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "canonical-protocol",
      "dependsOn": [
        "bl:BL-PROT-001"
      ]
    },
    {
      "@id": "bl:BL-PROT-008",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-008",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-008/",
      "schema:name": "Semantic gravity",
      "schema:text": "Mỗi public fragment nên liên kết machine-readable về Claim ID, canonical theory, author, version và provenance để giảm mất nguồn và tăng discoverability.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "technology-proposal",
      "dependsOn": [
        "bl:BL-PROT-005"
      ]
    },
    {
      "@id": "bl:BL-PROT-009",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PROT-009",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PROT-009/",
      "schema:name": "Distributed integrity-preserving replication",
      "schema:text": "Fork/mirror/translation nên giữ canonical origin, version, hash/signature và relation-to-origin để replication không xóa provenance.",
      "schema:additionalType": "protocol",
      "schema:creativeWorkStatus": "technology-proposal",
      "dependsOn": [
        "bl:BL-PROT-005"
      ]
    },
    {
      "@id": "bl:BL-P-015",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-015",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-015/",
      "schema:name": "Research infrastructure access is separable from institutional membership",
      "schema:text": "Trong nhiều bài toán lý thuyết/computational, AI+open literature+code+compute có thể làm một cá nhân tiếp cận research capabilities từng cần tổ chức lớn hơn; điều này không imply thay thế mọi laboratory.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "empirical-open",
      "dependsOn": [
        "bl:BL-PROT-003"
      ]
    },
    {
      "@id": "bl:BL-NCI",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-NCI",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-NCI/",
      "schema:name": "Nested Constituent Innovation",
      "schema:text": "Một cấu kiện được tái tổ hợp hoặc tái định nghĩa để có structure/role/function mới trong một system mới có thể là phát kiến cấp cấu kiện đồng thời là thành phần của phát kiến cấp hệ thống.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-P-013"
      ]
    },
    {
      "@id": "bl:BL-CNO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-CNO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-CNO/",
      "schema:name": "Combinatorial Novelty",
      "schema:text": "Các component đã biết không entail mọi tổ hợp của chúng đã biết; tổ hợp mới có thể là đối tượng novelty.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "formalizable",
      "dependsOn": [
        "bl:BL-P-009"
      ]
    },
    {
      "@id": "bl:BL-RNO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-RNO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-RNO/",
      "schema:name": "Relational Novelty",
      "schema:text": "Giữ node set nhưng thay các quan hệ có thể tạo một graph/object khác về cấu trúc.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "formalizable",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-SNO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-SNO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-SNO/",
      "schema:name": "Structural Novelty",
      "schema:text": "Một object có thể mới về cấu trúc dù component set của nó nằm trong prior knowledge.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-CNO",
        "bl:BL-RNO"
      ]
    },
    {
      "@id": "bl:BL-ANO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-ANO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-ANO/",
      "schema:name": "Architectural Novelty",
      "schema:text": "Một hệ có thể có novelty ở topology/organization toàn cục dù nhiều module riêng đã có tiền thân.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-SNO"
      ]
    },
    {
      "@id": "bl:BL-FNO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-FNO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-FNO/",
      "schema:name": "Functional Novelty",
      "schema:text": "Tổ hợp có thể sinh function ở cấp hệ không thuộc union function của component khi đứng riêng trong model tham chiếu.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-ANO"
      ]
    },
    {
      "@id": "bl:BL-PNO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-PNO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-PNO/",
      "schema:name": "Process Novelty",
      "schema:text": "Một transformation/process mới có thể là object phát kiến ngay cả khi output overlap với output đã biết.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-ENO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-ENO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-ENO/",
      "schema:name": "Emergent Novelty",
      "schema:text": "Property chỉ xuất hiện ở system level có thể được phân loại novelty riêng nếu không đồng nhất với simple union của component properties trong model.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-FNO"
      ]
    },
    {
      "@id": "bl:BL-IDR",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-IDR",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-IDR/",
      "schema:name": "Independent Derivational Novelty",
      "schema:text": "Similarity của output không tự chứng minh similarity/phụ thuộc của derivation; provenance paths phải được đánh giá riêng.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-P-014"
      ]
    },
    {
      "@id": "bl:BL-RDN",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-RDN",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-RDN/",
      "schema:name": "Reference-Domain Novelty",
      "schema:text": "Claim về novelty phải chỉ rõ reference domain/time; mới với agent, discipline hoặc humanity không đồng nhất mới tuyệt đối.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "canonical",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-NTO",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-NTO",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-NTO/",
      "schema:name": "Novel Transformation Originality",
      "schema:text": "Originality không đòi creation ex nihilo; nó có thể nằm ở phép biến đổi mới trên information đã hấp thụ.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-P-010",
        "bl:BL-IDR"
      ]
    },
    {
      "@id": "bl:BL-LSI",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-LSI",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-LSI/",
      "schema:name": "Latent Social Influence",
      "schema:text": "Environmental/social influence không đồng nhất direct dependence on a formal prior work; independent derivation không đòi zero prior influence.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-P-010",
        "bl:BL-IDR"
      ]
    },
    {
      "@id": "bl:BL-ICV",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-ICV",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-ICV/",
      "schema:name": "Independent Convergence",
      "schema:text": "Hai derivation có provenance độc lập có thể hội tụ vào outputs gần nhau.",
      "schema:additionalType": "relation",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-IDR"
      ]
    },
    {
      "@id": "bl:BL-IRC",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-IRC",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-IRC/",
      "schema:name": "Independent Reconstruction",
      "schema:text": "Một agent có thể tái dựng cấu trúc tương tự prior work trước khi đối chiếu trực tiếp formal prior work đó.",
      "schema:additionalType": "relation",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-ICV"
      ]
    },
    {
      "@id": "bl:BL-IGR",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-IGR",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-IGR/",
      "schema:name": "Independent Generalization",
      "schema:text": "Một derivation độc lập có thể hội tụ một phần rồi tạo formulation rộng hơn; overlap và extension phải được map riêng.",
      "schema:additionalType": "relation",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-IRC"
      ]
    },
    {
      "@id": "bl:BL-NVM",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-NVM",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-NVM/",
      "schema:name": "Novelty Vector Model",
      "schema:text": "Novelty được audit như vector primitive, relational, structural, architectural, functional, process, emergent và derivational thay vì nhị phân mới/không mới.",
      "schema:additionalType": "method",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-CNO",
        "bl:BL-RNO",
        "bl:BL-SNO",
        "bl:BL-ANO",
        "bl:BL-FNO",
