      "schema:identifier": "BL-BAE",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-BAE/",
      "schema:name": "Boundary Advantage Effect",
      "schema:text": "Một integrator có thể có lợi thế phát hiện cross-domain edges ở biên lĩnh vực, dù specialist giữ lợi thế depth trong cluster.",
      "schema:additionalType": "effect",
      "schema:creativeWorkStatus": "conjectural",
      "dependsOn": [
        "bl:BL-CRE"
      ]
    },
