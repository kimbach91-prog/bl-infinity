      "@id": "bl:BL-SDF",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-SDF",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-SDF/",
      "schema:name": "Selective Depth Function",
      "schema:text": "Một integrator không cần depth đồng đều; có thể phân bổ depth vào các node có leverage cao theo mục tiêu.",
      "schema:additionalType": "method",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-M-001"
      ]
    },
