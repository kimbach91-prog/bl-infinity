      "@id": "bl:BL-GSC",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-GSC",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-GSC/",
      "schema:name": "Generalist–Specialist Complementarity",
      "schema:text": "Specialist depth và integrator connectivity có thể là năng lực bổ sung thay vì thứ bậc một chiều.",
      "schema:additionalType": "principle",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-M-001",
