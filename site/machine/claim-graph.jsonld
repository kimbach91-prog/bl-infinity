      "schema:identifier": "BL-CRE",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-CRE/",
      "schema:name": "Cross-domain Recombination Engine",
      "schema:text": "Cơ chế sinh candidate mechanisms bằng cách tái tổ hợp primitives/relations từ nhiều miền rồi lọc theo utility/coherence.",
      "schema:additionalType": "mechanism",
      "schema:creativeWorkStatus": "proposed",
      "dependsOn": [
        "bl:BL-P-012",
        "bl:BL-CAF"
      ]
    },
