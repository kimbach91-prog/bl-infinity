      ]
    },
    {
      "@id": "bl:BL-EI-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-EI-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-EI-001/",
      "schema:name": "Known primitives are not proven final primitives",
      "schema:text": "Trong khoa học thực nghiệm, absence of currently known additional primitives không tự chứng minh ontology closure; closure phải dựa trên empirical/theoretical constraints cụ thể.",
      "schema:additionalType": "empirical-interface",
      "schema:creativeWorkStatus": "open-interface",
      "dependsOn": [
        "bl:BL-A-003"
      ]
    },
    {
      "@id": "bl:BL-P-010",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-010",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-010/",
      "schema:name": "Mệnh đề Hấp thụ",
      "schema:text": "Một embedded agent có thể hấp thụ statistical/causal regularities của môi trường qua exposure/feedback mà không nhận chúng dưới dạng formal theory.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-P-011",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-011",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-011/",
      "schema:name": "Formal education không phải toàn bộ learning",
      "schema:text": "Absence of formal training không tự entail absence of relevant internal structure acquired through other learning channels.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported",
      "dependsOn": [
        "bl:BL-P-010"
      ]
    },
    {
      "@id": "bl:BL-M-001",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-M-001",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-M-001/",
      "schema:name": "BDRAE cognitive profile",
      "schema:text": "Mô tả profile bằng Breadth, selective Depth, Association, Recombination, Execution và Metacognition thay vì một nhãn chuyên ngành đơn.",
      "schema:additionalType": "method",
      "schema:creativeWorkStatus": "method-proposed",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-T-004",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-T-004",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-T-004/",
      "schema:name": "Combinatorial domain count",
      "schema:text": "Với n domain phân biệt, số cặp domain là C(n,2), số subset không rỗng là 2^n-1.",
      "schema:additionalType": "theorem",
      "schema:creativeWorkStatus": "formal",
      "dependsOn": []
    },
    {
      "@id": "bl:BL-P-012",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-P-012",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-P-012/",
      "schema:name": "Breadth có thể tăng association opportunities phi tuyến",
      "schema:text": "Nếu domain knowledge tạo candidate relations, tăng số domain có thể làm số quan hệ/tổ hợp tiềm năng tăng nhanh hơn tuyến tính.",
      "schema:additionalType": "proposition",
      "schema:creativeWorkStatus": "supported-conditional",
