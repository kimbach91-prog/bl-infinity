      "@id": "bl:BL-CGF",
      "@type": "schema:CreativeWork",
      "schema:identifier": "BL-CGF",
      "schema:url": "https://kimbach91-prog.github.io/bl-infinity/claims/BL-CGF/",
      "schema:name": "Combinatorial Growth of Fields",
      "schema:text": "Với n miền, số cặp là C(n,2), bộ ba C(n,3), và số subset không rỗng là 2^n−1; breadth làm candidate combination space tăng tổ hợp trước filtering.",
      "schema:additionalType": "theorem-schema",
      "schema:creativeWorkStatus": "formal",
      "dependsOn": [
        "bl:BL-T-004"
      ]
    },
