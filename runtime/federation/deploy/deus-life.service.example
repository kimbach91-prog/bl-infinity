[Unit]
Description=DEUS Life/Affect + Federation Worker
Documentation=https://github.com/kimbach91-prog/bl-infinity/tree/main/runtime/federation
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=deus-life
Group=deus-life
WorkingDirectory=/opt/bl-infinity/runtime/federation
EnvironmentFile=-/etc/deus-life.env
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=DEUS_LIFE_STATE_PATH=/var/lib/deus-life/deus-life-state.json
Environment=DEUS_LIFE_JOURNAL_PATH=/var/lib/deus-life/deus-life-events.ndjson
Environment=DEUS_LIFE_LEASE_PATH=/var/lib/deus-life/deus-life.lock
Environment=DEUS_LIFE_CHECKPOINT_PATH=/var/lib/deus-life/deus-life-checkpoint.json
Environment=DEUS_LIFE_PULSE_MS=20000
Environment=DEUS_LIFE_LEASE_TTL_MS=90000
ExecStart=/usr/bin/node worker/life-worker.mjs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
StateDirectory=deus-life
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/deus-life

[Install]
WantedBy=multi-user.target
