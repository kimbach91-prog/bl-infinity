{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimbach91-prog.github.io/bl-infinity/public-compute/deus-worker-offer.schema.json",
  "title": "DEUS Worker Offer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","worker_id","resource_class","owner_authorized","auto_trial_allowed","data_ceiling","settlement_class","max_trial_seconds","capabilities","stop_condition"],
  "properties": {
    "schema": {"const": "deus-worker-offer/1"},
    "worker_id": {"type":"string","pattern":"^[A-Za-z0-9._:-]{3,100}$"},
    "resource_class": {"enum":["CPU","GPU","WEBGPU","LLM","CONTAINER","CI","WASM"]},
    "owner_authorized": {"const": true},
    "auto_trial_allowed": {"const": true},
    "data_ceiling": {"enum":["BL-S0","BL-S1"]},
    "settlement_class": {"enum":["NO_SPEND","RESULT_SWAP","PUBLIC_BENEFIT","QUOTE_ONLY"]},
    "max_trial_seconds": {"type":"integer","minimum":1,"maximum":300},
    "capabilities": {"type":"array","maxItems":20,"items":{"type":"string","maxLength":120}},
    "stop_condition": {"type":"string","minLength":1,"maxLength":500}
  }
}
