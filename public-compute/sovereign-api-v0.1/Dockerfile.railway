FROM node:22-alpine
LABEL org.opencontainers.image.source="https://github.com/kimbach91-prog/bl-infinity"
LABEL org.opencontainers.image.title="DEUS Sovereign API Railway Runtime"
LABEL org.opencontainers.image.description="Public-safe S0/S1 Sovereign API + provider-native Railway controller adapter"
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
COPY src ./src
EXPOSE 8080
CMD ["node", "src/railway-runtime.mjs"]
