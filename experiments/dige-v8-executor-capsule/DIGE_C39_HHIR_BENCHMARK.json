{
  "schema": "dige-hhir-hyperreal-benchmark/1",
  "benchmark_id": "DIGE_C39_HHIR_HYPERREAL_AB_V1",
  "objective": "Test whether DEUS heterogeneous representation/HHIR produces a cleaner causal repair path for the current DiGe hyperreal workload than the direct C36/G continuation, while producing a new source-level hyperreal candidate.",
  "frozen_task": {
    "target": "C38 coherent human realism with believable face/eyelids, source-level bun/updo groom, skin material response, fixed camera, no reference-pixel reuse",
    "baseline": "C36_G_LONG01 direct continuation",
    "candidate": "C39_HHIR_HYPERREAL_UPDO_V1",
    "renderer": "Blender 5.2.2 / Cycles / CPU",
    "preview_samples": 96
  },
  "hhir_graph": [
    {
      "id": "GEOMETRY_FACE",
      "lane": "graph+numeric",
      "inputs": [
        "GNM landmarks",
        "body geometry"
      ],
      "invariants": [
        "same subject",
        "no 2D face patch"
      ],
      "output": "face/eyelid geometry contract"
    },
    {
      "id": "EYE_INTERFACE",
      "lane": "geometry+material",
      "inputs": [
        "eye landmarks",
        "cornea/iris stack"
      ],
      "invariants": [
        "reduced sclera",
        "wetline preserved"
      ],
      "output": "eye interface"
    },
    {
      "id": "SKIN_PBR",
      "lane": "material+stochastic",
      "inputs": [
        "MPFB2 mature graph",
        "CC0 albedo"
      ],
      "invariants": [
        "source provenance",
        "lighting-dependent response"
      ],
      "output": "scale-separated skin response"
    },
    {
      "id": "GROOM_UPDO",
      "lane": "graph+procedural geometry",
      "inputs": [
        "scalp/hairline geometry"
      ],
      "invariants": [
        "no long01 final-style curtain",
        "face clearance",
        "bun coherent"
