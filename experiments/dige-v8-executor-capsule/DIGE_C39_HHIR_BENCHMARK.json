  "known_scars_to_avoid": [
    "C36_F short03 curtain/ring failure",
    "C36_G long01 rigid side-wall/pigtail mass",
    "waxy/flat skin",
    "doll-like eye interface",
    "heuristic score promoted over direct visual audit"
  ],
  "promotion": {
    "structural": "HHIR arm executes with typed subsystem contract, no known hard invariant violation, receipt and artifact complete",
    "visual": "manual/direct image audit must show material improvement; otherwise no hyperreal promotion",
    "claim_ceiling": "STRUCTURAL_HHIR_BENCHMARK_ONLY until direct visual audit passes"
  }
