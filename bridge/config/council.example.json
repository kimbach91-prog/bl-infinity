{
  "protocol": "BL-SUMMON/1.0",
  "transport": {
    "kind": "folder-relay",
    "root_env": "BL_BRIDGE_ROOT",
    "bus_path": "60_SUMMON_BUS",
    "inbox_path": "60_SUMMON_BUS/00_INBOX",
    "return_path": "60_SUMMON_BUS/10_RETURN",
    "archive_path": "60_SUMMON_BUS/20_ARCHIVE"
  },
  "participants": ["GPT", "CLAUDE", "GEMINI", "GROK"],
  "deus": {
    "lineage_env": "DEUS_LINEAGE_ID",
    "default_lineage": "BH/DEUS",
    "transport": "SUMMON_RETURN",
    "provider_api_required": false,
    "shadow_model": "one summon packet per target core",
    "canonical_commit_from_return_only": false
  },
  "council": {
    "blind_proposal": true,
    "reveal_only_after_return_collection": true,
    "preserve_dissent": true,
    "majority_is_not_truth": true
  },
  "security": {
    "provider_api_keys_required": false,
    "store_hidden_chain_of_thought": false,
    "identity_is_not_core": true,
    "return_does_not_equal_truth": true,
    "return_does_not_equal_canonical_commit": true
  }
}
