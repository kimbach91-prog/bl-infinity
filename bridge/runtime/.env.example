# Independent provider/core adapters
# Set exact model IDs available to your accounts. Keep API keys out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# xAI / Grok. The runtime uses the OpenAI-compatible Responses API at https://api.x.ai/v1.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Optional dedicated DEUS HTTP runtime. If configured, AUTO prefers this endpoint.
DEUS_ENDPOINT=
DEUS_BRIDGE_TOKEN=
DEUS_RUNTIME_ID=

# Portable DEUS identity / BH-rooted lineage
DEUS_LINEAGE_ID=BH/DEUS
DEUS_POLICY_VERSION=DEUS-PORTABLE-IDENTITY-v1
DEUS_AUTHORITY_SCOPE=coordinate,synthesize,propose
DEUS_CHECKPOINT_REF=
DEUS_CHECKPOINT_HASH=
DEUS_PARENT_INSTANCE_ID=

# DEUS core mobility
# AUTO = dedicated HTTP if present, else MULTI when >1 selected core, else SINGLE.
# Other values: HTTP, SINGLE, MULTI
DEUS_CORE_MODE=AUTO
DEUS_CORE_ORDER=GPT,CLAUDE,GEMINI,GROK
DEUS_PRIMARY_CORE=GPT
DEUS_SYNTHESIS_CORE=
DEUS_COUNCIL_PARTICIPANT=true

# DEUS shadows
DEUS_SHADOW_CORES=GPT,CLAUDE,GEMINI,GROK
DEUS_SHADOW_EXPIRES_AT=
DEUS_PUBLISH_DIRECT=false
DEUS_TASK=

# Google Drive broker credential. Keep this secret.
# Store the full one-line service-account JSON object here.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Private vaults
BL_GPT_VAULT_ID=
BL_CLAUDE_VAULT_ID=
BL_GEMINI_VAULT_ID=
BL_GROK_VAULT_ID=
BL_DEUS_VAULT_ID=

# DEUS lineage sub-vaults
BL_DEUS_CANONICAL_FOLDER_ID=
BL_DEUS_CHECKPOINTS_FOLDER_ID=
BL_DEUS_SHADOWS_FOLDER_ID=
BL_DEUS_MIGRATIONS_FOLDER_ID=
BL_DEUS_ENSEMBLES_FOLDER_ID=
BL_DEUS_LOGS_FOLDER_ID=

# Shared Commons subfolders
BL_AGENDA_FOLDER_ID=
BL_PROPOSALS_FOLDER_ID=
BL_EVIDENCE_FOLDER_ID=
BL_DEBATES_FOLDER_ID=
BL_DECISIONS_FOLDER_ID=
BL_DISSENT_FOLDER_ID=
BL_BENCHMARKS_FOLDER_ID=
BL_ARTIFACTS_FOLDER_ID=

# One-shot agenda alternative to CLI args
BL_AGENDA=
