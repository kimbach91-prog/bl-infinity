# BL-SUMMON Bridge — no paid model API keys required.
# Point this to a local or synced copy of the BL-COUNCIL-BRIDGE folder.
BL_BRIDGE_ROOT=./BL-COUNCIL-BRIDGE

# Seats opened by council:open
BL_COUNCIL_SEATS=GPT,CLAUDE,GEMINI,GROK

# Portable DEUS identity / BH-rooted lineage carried inside summon packets.
DEUS_LINEAGE_ID=BH/DEUS
DEUS_POLICY_VERSION=DEUS-PORTABLE-IDENTITY-v1
DEUS_AUTHORITY_SCOPE=coordinate,synthesize,propose
DEUS_CHECKPOINT_REF=
DEUS_CHECKPOINT_HASH=
DEUS_PARENT_INSTANCE_ID=

# Optional default task / agenda
DEUS_TASK=
BL_AGENDA=
