{
  "schema_version": "1.0",
  "policy_id": "BL-GWG",
  "canonical_name": "Bach Lam Git Write Guard",
  "status": "adopted",
  "scope": "ALL_PUBLIC_GIT_MUTATIONS",
  "default_decision": "DENY_UNTIL_ALL_GATES_PASS",
  "owner_publication_freeze": true,
  "publication_requires_explicit_owner_command": true,
  "pre_write_required": true,
  "post_write_audit_required": true,
  "server_side_ruleset_required_for_hard_pre_receive_enforcement": true,
  "gates": [
    {"id":"GW0","name":"Authority and intent","required":["explicit_owner_command_for_public_mutation","no_implicit_publication","no_background_publication"]},
    {"id":"GW1","name":"Disclosure classification","required":["classify_OPEN_P0_or_CONTROLLED_P1","reject_PROTECTED_P2","reject_FORBIDDEN_P3"]},
    {"id":"GW2","name":"Data minimization","required":["smallest_sufficient_public_projection","remove_private_runtime_detail","remove_unnecessary_internal_reasoning_or_handoff_material"]},
    {"id":"GW3","name":"Secret privacy and credential scan","required":["secret_pattern_scan","private_key_scan","credential_path_scan","sensitive_private_payload_scan"]},
    {"id":"GW4","name":"Provenance and IP boundary","required":["preserve_origin_and_lineage","no_silent_authorship_rewrite","patent_or_trade_secret_disclosure_risk_review_when_material","public_provenance_sanitization"]},
    {"id":"GW5","name":"Active content and supply chain","required":["unsafe_url_scan","active_script_boundary_check","dependency_and_action_pin_check","no_untrusted_runtime_material"]},
    {"id":"GW6","name":"Integrity and semantic diff","required":["identity_version_history_preserved","no_silent_merge","no_security_boundary_downgrade","machine_contract_consistency"]},
    {"id":"GW7","name":"Release separation","required":["git_write_not_equal_pages_publish","automated_events_audit_only","pages_publish_manual_only","index_notification_manual_publish_only"]},
    {"id":"GW8","name":"Post-write fail-closed verification","required":["BL_CPR_audit","security_audit","unified_system_audit","site_audit_if_built","rollback_or_quarantine_on_failure"]},
    {"id":"GW9","name":"Platform enforcement target","required":["repository_ruleset_or_branch_protection","required_checks_before_merge","review_for_sensitive_changes","minimal_admin_bypass"]}
  ],
  "nonclaims": [
    "CI_after_push_cannot_make_already_public_bytes_secret_again",
    "repository_code_cannot_guarantee_account_level_MFA_or_platform_rulesets",
    "security_checks_do_not_prove_theory_truth"
  ],
  "invariants": [
    "PUBLIC_GIT_WRITE_IS_AN_EXPOSURE_EVENT",
    "NO_SINGLE_SECURITY_LAYER_IS_SUFFICIENT",
    "FAIL_CLOSED_ON_UNKNOWN_DISCLOSURE_CLASS",
    "PUBLICATION_REQUIRES_MINIMUM_NECESSARY_INFORMATION",
    "PROTECTED_RUNTIME_NEVER_BECOMES_PUBLIC_BY_CONVENIENCE",
    "OWNER_COMMAND_DOES_NOT_BYPASS_SECRET_OR_P3_GATES",
    "AUTOMATION_MAY_AUDIT_BUT_MAY_NOT_AUTO_PUBLISH"
  ],
  "lineage": {
    "parent_policies": ["BL-CPR", "BL-INFINITY-PUBLIC-SECURITY-PROFILE"],
    "origin_of_requirement": "Bach Lam",
    "formalization": "author-directed assistance",
    "seal": "ADN BACH LAM"
  }
}
