{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_id": "BL-CPR",
  "version": "1.3",
  "status": "adopted",
  "effective_date": "2026-08-31",
  "decision": "open_verifiable_knowledge_protected_runtime",
  "git_write_gate": {
    "policy": "BL-GWG",
    "path": "git-write-gate.json",
    "default": "DENY_UNTIL_ALL_GATES_PASS",
    "pre_write_classification_required": true,
    "post_write_audit_required": true,
    "explicit_owner_command_required_for_public_mutation": true,
    "unknown_class_fails_closed": true,
    "owner_command_cannot_bypass_secret_or_forbidden_material_gate": true
  },
  "repository_boundary": {
    "public_repository_is_exposure_boundary": true,
    "absence_from_navigation_or_sitemap_is_not_privacy": true,
    "protected_material_must_live_outside_public_repository": true,
    "allowed_repository_disclosure_classes": ["OPEN/P0", "CONTROLLED/P1"],
    "forbidden_repository_disclosure_classes": ["PROTECTED/P2", "FORBIDDEN/P3"]
  },
  "public_required": [
    "canonical_identity",
    "claim_truth_conditions",
    "claim_dependencies",
    "evidence_and_adverse_evidence",
    "provenance_class",
    "sanitized_public_provenance",
    "limitations_and_nonclaims",
    "critique_and_resolution_history",
    "public_reference_schema_and_tests"
  ],
  "controlled_or_protected": [
    "production_prompts",
    "boot_prompts",
    "model_or_operator_handoffs",
    "private_routing_weights",
    "private_activation_triggers",
    "private_diagnostics",
    "full_internal_adversarial_operator_lists",
    "private_refinement_orchestration",
    "private_corpus",
    "raw_or_detailed_private_conversations",
    "detailed_generative_reasoning_trace_not_required_for_claim_verification",
    "operator_only_playbooks",
    "commercial_execution_details_not_affecting_truth_status"
  ],
  "forbidden_path_prefixes": [
    "handoff/", "private-runtime/", "private_runtime/", "runtime-private/", "runtime_private/", "runtime/",
    "private-diagnostics/", "private_diagnostics/", "raw-private/", "raw_private/", "secrets/", "credentials/",
    "operator-only/", "operator-handoff/", "provenance/raw/", "provenance/private/"
  ],
  "forbidden_filename_tokens": [
    "NEXT_MODEL_PROMPT", "BOOT_PROMPT", "RUNTIME_CORE", "OPERATOR_PLAYBOOK", "RAW_TRANSCRIPT", "CONVERSATION_LOG"
  ],
  "forbidden_secret_material": ["private_key", "github_token", "openai_api_key", "aws_access_key"],
  "public_machine_contract": {
    "allowed": ["identity", "purpose", "public_inputs_outputs", "authority_boundaries", "guardrails", "falsifiers", "reference_behavior"],
    "protected": ["production_pipeline", "activation_triggers", "internal_target_ranking", "full_operator_inventory", "private_diagnostics", "routing_weights"]
  },
  "artifact_classes": {
    "OPEN/P0": ["canonical_manifest", "claim_index", "asset_index", "disclosure_policy", "canonical_public_claim_pages"],
    "CONTROLLED/P1": ["public_claim_registry_without_private_reasoning", "novelty_ontology_projection", "conceptual_logic_projection", "entity_relation_projection", "historical_provenance_projection", "public_adversarial_interface_contract", "discovery_orientation_material", "public_security_policy_and_gate_contracts"],
    "PROTECTED/P2": ["asset_level_runtime_composition", "private_router", "activation_logic", "target_ranking", "operator_sequence", "private_diagnostics", "private_model_or_operator_handoffs", "private_provenance_payloads"],
    "FORBIDDEN/P3": ["credentials", "tokens", "private_signing_keys", "unlawfully_exposed_personal_data", "equivalent_sensitive_secret_material"]
  },
  "projection_rule": "When a public claim needs machine verification, publish the smallest sufficient projection. Do not publish a richer internal object merely because it already exists in machine-readable form.",
  "pre_write_rule": "Before any public Git mutation, classify the candidate, minimize it, scan secrets/privacy, preserve provenance, assess IP/publication risk when material, and deny the write if any required gate is unresolved.",
  "history_response": {
    "preserve_private_archive": true,
    "remove_active_public_copy": true,
    "rewrite_public_refs_from_clean_anchor_when_feasible": true,
    "regenerate_public_artifacts": true,
    "provider_cache_purge_may_be_required_for_byte_level_erasure": true
  },
  "anti_secrecy_escape": "If a protected object is necessary to verify a public claim, narrow, downgrade, withhold or controlled-review that claim.",
  "lineage": {
    "origin_of_problem": "Bách Lâm",
    "formalization": "AI",
    "provenance": ["LKB_DIRECT", "NEW_FORMALIZATION"],
    "seal": "ADN BÁCH LÂM ∞"
  }
}
